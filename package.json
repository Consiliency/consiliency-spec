    "tests/test_outside_agent_route_verdict_schema.py",
    "tests/test_outside_agent_submission_schema.py",
    "tests/test_outside_agent_vectors.py"
  ],
  "scripts": {
    "test": "bash scripts/consiliency-spec/check_release.sh"
  },
